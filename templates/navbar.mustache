{{!

    @template theme_boost/navbar

    This template renders the top navbar.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            },
            {
                "text": "Site home",
                "url": "/",
                "isactive": false
            },
            {
                "text": "My courses",
                "url": "/course",
                "isactive": false
            }
        ]
    }
}}
<nav class="navbar fixed-top bg-body navbar-expand" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid navbar-content">
        <button type="button" class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0"
                data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary"
                aria-controls="theme_boost-drawers-primary" aria-expanded="false">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn">

            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                {{{ sitename }}}
            {{/ output.should_display_navbar_logo }}
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/primarymoremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                <!-- page_heading_menu -->
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{# output.search_box }}
                {{{ output.search_box }}}
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{# output.colour_mode_menu }}
                {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/ output.colour_mode_menu }}
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
            {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}

{{#js}}
require(['theme_boost/drawers'], function(Drawers) {
    // Keep the state of drawer controls in sync, including drawers which start open.
    // This uses the existing drawer events and does not need an additional compiled AMD module.
    const syncDrawerControls = drawer => {
        if (!drawer || !drawer.id) {
            return;
        }
        document.querySelectorAll('[data-toggler="drawers"][data-target]').forEach(button => {
            if (button.dataset.target !== drawer.id ||
                    !['toggle', 'opendrawer'].includes(button.dataset.action)) {
                return;
            }
            button.setAttribute('aria-controls', drawer.id);
            button.setAttribute('aria-expanded', drawer.classList.contains('show') ? 'true' : 'false');
        });
    };

    document.querySelectorAll('[data-region="fixed-drawer"]').forEach(syncDrawerControls);
    document.addEventListener(Drawers.eventTypes.drawerShown, event => syncDrawerControls(event.target));
    document.addEventListener(Drawers.eventTypes.drawerHidden, event => syncDrawerControls(event.target));

    // Allow keyboard users to dismiss the drawer without trapping focus inside it.
    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape' || event.defaultPrevented) {
            return;
        }
        if (!(event.target instanceof Element)) {
            return;
        }
        const drawer = event.target.closest('[data-region="fixed-drawer"].show');
        if (!drawer || event.target.closest('.dropdown-menu.show, [role="listbox"], [role="dialog"], input, select, textarea')) {
            return;
        }
        const instance = Drawers.getDrawerInstanceForNode(drawer);
        if (instance) {
            event.preventDefault();
            instance.closeDrawer();
        }
    });
});
{{/js}}
